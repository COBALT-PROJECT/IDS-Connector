# ============================================
# IDS Sync Service Configuration (VM1)
# ============================================

# === PROVIDER (VM2) ACCESS ===
# Set this to VM2's IP address once deployed
# PROVIDER_NODE_IP=10.10.2.20 #dummyToE VM IP address
# PROVIDER_NODE_PORT=30578

# Or use direct URL:
PROVIDER_URL=https://10.10.2.20:30578

# === CONSUMER ACCESS ===
# Update based on where consumer is deployed (but when we are running this as a pod, we can simply use 'tc-consumer' instead of service IP)
CONSUMER_URL=https://10.43.201.32:8444

# === CREDENTIALS ===
IDS_USERNAME=admin
IDS_PASSWORD=password

# === SYNC CONFIGURATION ===
POLL_INTERVAL_SECONDS=10
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
CONNECTION_TIMEOUT=30

# === LOGGING ===
LOG_LEVEL=INFO
LOG_DIR=./logs

# === HEALTH CHECK ===
HEALTH_PORT=8080